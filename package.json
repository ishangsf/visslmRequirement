{
  "name": "visslm-agent-desktop",
  "version": "1.0.0",
  "private": true,
  "author": "VISSLM Agent Team",
  "description": "VISSLM data collection, knowledge search and local AI agent desktop app",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "prepare:model": "node scripts/prepare-local-resources.mjs",
    "knowledge:smoke": "node scripts/smoke-knowledge.mjs",
    "smoke:project-management": "npx tsx ./scripts/smoke-project-management.ts",
    "smoke:project-export": "npx tsx ./scripts/smoke-project-export.ts",
    "smoke:project-management-ui": "node ./scripts/smoke-project-management-ui.mjs",
    "smoke:dashboard-editor": "npx tsx ./scripts/smoke-dashboard-editor.ts",
    "smoke:dashboard-versions": "npx tsx ./scripts/smoke-dashboard-versions.ts",
    "smoke:dashboard-version-ui": "node ./scripts/smoke-dashboard-version-ui.mjs",
    "smoke:dashboard-quality": "npx tsx ./scripts/smoke-dashboard-quality.ts",
    "smoke:dashboard-inspector-ui": "node ./scripts/smoke-dashboard-inspector-ui.mjs",
    "smoke:dashboard-golden": "npx tsx ./scripts/smoke-dashboard-golden.ts",
    "smoke:dashboard-performance": "npx tsx ./scripts/smoke-dashboard-performance.ts",
    "smoke:dashboard-visual-matrix": "npx tsx ./scripts/smoke-dashboard-visual-matrix.ts",
    "smoke:dashboard-electron-visual": "npx tsx ./scripts/smoke-dashboard-electron-visual.ts",
    "smoke:dashboard-electron-visual-matrix": "npx tsx ./scripts/smoke-dashboard-electron-visual-matrix.ts",
    "smoke:dashboard-audit": "npx tsx ./scripts/smoke-dashboard-audit.ts",
    "smoke:dashboard-repair": "npx tsx ./scripts/smoke-dashboard-repair.ts",
    "smoke:dashboard-ai-context": "npx tsx ./scripts/smoke-dashboard-ai-context.ts",
    "smoke:dashboard-ai-provider-contract": "npx tsx ./scripts/smoke-dashboard-ai-provider-contract.ts",
    "smoke:dashboard-ai-snapshot": "npx tsx ./scripts/smoke-dashboard-ai-snapshot.ts",
    "smoke:dashboard-ai-ui": "node ./scripts/smoke-dashboard-ai-drawer-ui.mjs",
    "smoke:dashboard-ai-live": "npx tsx ./scripts/smoke-dashboard-ai-live.ts",
    "smoke:dashboard-pixel-diff": "npx tsx ./scripts/smoke-dashboard-pixel-diff.ts",
    "smoke:visualization-regression": "npx tsx ./scripts/smoke-visualization-regression.ts",
    "smoke:query-formulas": "npx tsx ./scripts/smoke-query-formulas.ts",
    "package": "npm run prepare:model && npm run build && electron-builder --win",
    "package:dir": "npm run prepare:model && npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@huggingface/transformers": "^4.2.0",
    "@napi-rs/canvas": "^1.0.3",
    "antd": "^6.1.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "html-to-image": "^1.11.13",
    "iconv-lite": "^0.7.3",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "ws": "^8.21.1"
  },
  "build": {
    "appId": "com.visslm.agent.desktop",
    "productName": "VISSLM Agent",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@napi-rs/canvas/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**"
    ],
    "extraResources": [
      {
        "from": "buildResources/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "buildResources/ocr",
        "to": "ocr",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "buildResources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
