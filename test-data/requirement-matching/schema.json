{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visslm.local/schemas/requirement-matching-evaluation.json",
  "title": "VISSLM requirement matching evaluation assets",
  "type": "object",
  "required": ["schemaVersion", "annotationStatus", "queries"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "annotationStatus": { "type": "string", "enum": ["scaffold", "ready"] },
    "provenance": { "type": "string" },
    "splitPolicy": { "type": "string" },
    "queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/query"
      }
    }
  },
  "$defs": {
    "relation": {
      "type": "string",
      "enum": ["duplicate", "highly_similar", "partial_overlap", "same_pattern", "topic_only", "unrelated"]
    },
    "query": {
      "type": "object",
      "required": ["queryId", "baseItemId", "split", "pairs"],
      "properties": {
        "queryId": { "type": "string", "minLength": 1 },
        "baseItemId": { "type": "string", "minLength": 1 },
        "split": { "type": "string", "enum": ["train", "validation", "test"] },
        "source": { "type": "string", "enum": ["human", "contract", "synthetic"] },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["candidateItemId", "relation", "relevance"],
            "properties": {
              "candidateItemId": { "type": "string", "minLength": 1 },
              "relation": { "$ref": "#/$defs/relation" },
              "relevance": { "type": "integer", "minimum": 0, "maximum": 3 },
              "hardNegative": { "type": "boolean" },
              "adjudication": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
